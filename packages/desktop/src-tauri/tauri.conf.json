{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gadgets Desktop",
  "version": "0.0.0",
  "identifier": "dev.gadgets.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Gadgets Desktop", "width": 860, "height": 780 }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "resources/llama/": "llama/", "resources/workshop/": "workshop/" }
  }
}
